{
  "name": "menu-tv",
  "productName": "Menu TV",
  "version": "1.0.0",
  "description": "Menu TV : chaînes, films et séries",
  "author": "Menu TV",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node preparer.js && electron .",
    "dist": "node preparer.js && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "fr.menutv.pc",
    "productName": "Menu TV",
    "files": ["main.js", "proxy.js", "icone.ico", "package.json"],
    "extraResources": [{ "from": "www", "to": "www" }],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "icone.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Menu TV",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Installer Menu TV.${ext}"
    }
  }
}
